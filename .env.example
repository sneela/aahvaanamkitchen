# Atlas project aahvaanamkitchen, Cluster0 (AWS us-east-1, M0)
# Keep real values in your hosting environment, not GitHub.
MONGODB_URI=
MONGODB_DB_NAME=aahvaanam_kitchen
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Optional merchant notifications. Leave empty to disable each channel.
# Email: verify your sending domain with Resend first. Alerts go to you, not shoppers.
RESEND_API_KEY=
ORDER_ALERT_FROM_EMAIL=
ORDER_ALERT_EMAIL=

# SMS: requires an active Twilio sender and may incur per-message/carrier fees.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
ORDER_ALERT_SMS_TO=

# WhatsApp: optional approved sender + pre-approved utility template.
# The template must contain placeholders {{1}} for order number and {{2}} for total.
TWILIO_WHATSAPP_FROM=
ORDER_ALERT_WHATSAPP_TO=
TWILIO_WHATSAPP_TEMPLATE_SID=
